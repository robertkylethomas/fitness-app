<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence 
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="FitChallengePU" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/ExampleDS</jta-data-source>
        <class>com.udacity.fitchallenge.entity.User</class>
        <class>com.udacity.fitchallenge.entity.Challenge</class>
        <class>com.udacity.fitchallenge.entity.ProgressLog</class>
        <class>com.udacity.fitchallenge.entity.Achievement</class>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" 
                      value="drop-and-create"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
